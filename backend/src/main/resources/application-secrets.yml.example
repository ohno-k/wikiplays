# =========================================================
#  application-secrets.yml.example
# =========================================================
# このファイルを `application-secrets.yml` にリネームしてキーを書く。
# `application-secrets.yml` 本体は .gitignore で除外されており、絶対にコミットしない。
#
# 起動方法 (PowerShell):
#   cd backend
#   .\mvnw.cmd spring-boot:run
# =========================================================

wikiplays:
  # ----- Stripe ----- (https://dashboard.stripe.com/test/apikeys)
  stripe:
    # テストキー: sk_test_xxxxx で始まる (本番では sk_live_xxxxx)
    # 推奨: Restricted API Key (rk_test_xxxxx) を使うとさらに安全
    secret-key: "sk_test_REPLACE_ME"
    # Stripe Dashboard > 商品 で作成した 3 プランの Price ID
    price-id-1m: "price_REPLACE_ME"   # 月額 ¥500
    price-id-3m: "price_REPLACE_ME"   # 3 ヶ月 ¥1,300
    price-id-6m: "price_REPLACE_ME"   # 6 ヶ月 ¥2,000
    # Stripe CLI: `stripe listen --forward-to localhost:8080/api/stripe/webhook` で表示される whsec_xxxxx
    webhook-secret: "whsec_REPLACE_ME"

# ----- Google OAuth ----- (https://console.cloud.google.com/apis/credentials)
# (任意。設定しないと Google ログインボタンが動作しない)
# spring:
#   security:
#     oauth2:
#       client:
#         registration:
#           google:
#             client-id: "REPLACE_ME.apps.googleusercontent.com"
#             client-secret: "REPLACE_ME"

# ----- SMTP (メール送信) -----
# (任意。設定しないと検証メール・パスワードリセットメールは出力先がログのみ)
# spring:
#   mail:
#     host: smtp.sendgrid.net
#     port: 587
#     username: apikey
#     password: "SG.REPLACE_ME"
# wikiplays:
#   mail:
#     from: "no-reply@wikiplays.me"
